// ── STATE ────────────────────────────────────────────────────
let STATE = {
  moto: null,
  kmBase: 0,
  kmDia: 35,
  fechaBase: null,
  llantas: 'calle',
  bigFive: {},
  historial: [],
  foto: null,
  accesorios: { alarmaPila: null, soatVence: null, tecnoVence: null, seguroVence: null },
};

// ── INIT ─────────────────────────────────────────────────────
window.onload = () => {
  populateMarcas();
  const saved = localStorage.getItem('tmad_state');
  if (saved) {
    try { STATE = JSON.parse(saved); } catch(e) {}
  }
};

function save() { localStorage.setItem('tmad_state', JSON.stringify(STATE)); }

function getKmActual() {
  if (!STATE.fechaBase || !STATE.kmBase) return STATE.kmBase || 0;
  const dias = Math.floor((Date.now() - STATE.fechaBase) / 86400000);
  return Math.round(STATE.kmBase + dias * STATE.kmDia);
}

// ── ONBOARDING ───────────────────────────────────────────────
let currentStep = 1;

function startOnboarding() {
  document.getElementById('splash').style.display = 'none';
  document.getElementById('onboarding').style.display = 'block';
  renderProgBar(1, 4);
  goStep(1);
}

function loadFromStorage() {
  if (STATE.moto) { showMainApp(); }
  else { alert('No hay datos guardados. Registra tu moto primero.'); }
}

function renderProgBar(step, total) {
  const bar = document.getElementById('prog-bar');
  bar.innerHTML = Array.from({length: total}, (_, i) =>
    `<div class="prog-dot ${i < step-1 ? 'done' : i === step-1 ? 'active' : ''}"></div>`
  ).join('');
}

function goStep(n) {
  document.querySelectorAll('#onboarding .screen').forEach(s => s.classList.remove('active'));
  document.getElementById(`step${n}`).classList.add('active');
  renderProgBar(n, 4);
  currentStep = n;
  if (n === 2) {
    // Pre-fill email if already saved
    const emailEl = document.getElementById('inp-email-ob');
    if (emailEl && STATE.email) { emailEl.value = STATE.email; validarStep2(); }
  }
  if (n === 3) renderBig5();
}

function populateMarcas() {
  const sel = document.getElementById('sel-marca');
  Object.keys(MOTOS_DB).forEach(m => {
    const opt = document.createElement('option');
    opt.value = m; opt.textContent = m;
    sel.appendChild(opt);
  });
}

function onMarcaChange() {
  const marca = document.getElementById('sel-marca').value;
  const selMod = document.getElementById('sel-modelo');
  const selAño = document.getElementById('sel-año');
  selMod.innerHTML = '<option value="">Selecciona el modelo</option>';
  selAño.innerHTML = '<option value="">Primero elige el modelo</option>';
  selMod.disabled = !marca;
  selAño.disabled = true;
  document.getElementById('ficha-preview').style.display = 'none';
  document.getElementById('btn-step1').disabled = true;
  if (!marca) return;
  Object.keys(MOTOS_DB[marca].modelos).forEach(mod => {
    const opt = document.createElement('option');
    opt.value = mod; opt.textContent = mod;
    selMod.appendChild(opt);
  });
}

function onModeloChange() {
  const marca = document.getElementById('sel-marca').value;
  const modelo = document.getElementById('sel-modelo').value;
  const selAño = document.getElementById('sel-año');
  selAño.innerHTML = '<option value="">Selecciona el año</option>';
  document.getElementById('ficha-preview').style.display = 'none';
  document.getElementById('btn-step1').disabled = true;
  selAño.disabled = !modelo;
  if (!modelo) return;
  ['2024','2023','2022','2021','2020','2019','2018','2017'].forEach(a => {
    const opt = document.createElement('option'); opt.value = a; opt.textContent = a; selAño.appendChild(opt);
  });
  selAño.onchange = () => {
    if (!selAño.value) return;
    const d = MOTOS_DB[marca].modelos[modelo];
    const ficha = document.getElementById('ficha-preview');
    ficha.style.display = 'block';
    ficha.innerHTML = `
      <div style="background:linear-gradient(135deg,#1a0a0a,#1a1a1a);border:1px solid var(--red-dim);border-radius:12px;padding:14px 16px;margin-top:12px">
        <div style="font-size:11px;color:var(--red);font-weight:700;letter-spacing:1px;margin-bottom:10px">✅ FICHA CARGADA — ${marca} ${modelo}</div>
        ${[['Aceite rec.',d.aceiteRec],['Intervalo aceite',`${d.intervalos.aceite.toLocaleString()} km`],['Refrigeración',d.refrigeracionLiquida?'Líquida':'Aire'],['Tipo',d.tipo]].map(([k,v])=>`
          <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--border)">
            <span style="font-size:12px;color:var(--metal)">${k}</span>
            <span style="font-size:12px;color:var(--white);font-weight:600">${v}</span>
          </div>`).join('')}
      </div>`;
    document.getElementById('btn-step1').disabled = false;
    STATE.moto = { marca, modelo, año: selAño.value, ...d };
    save();
  };
}

function validarStep2() {
  const email = document.getElementById('inp-email-ob')?.value.trim() || '';
  const km = document.getElementById('inp-km')?.value.trim() || '';
  const emailValido = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  const errorEl = document.getElementById('email-error');
  const btn = document.getElementById('btn-step2');

  if (errorEl) errorEl.style.display = email && !emailValido ? 'block' : 'none';
  if (btn) btn.disabled = !(emailValido && km);
}

function avanzarStep2() {
  const email = document.getElementById('inp-email-ob').value.trim();
  const km = document.getElementById('inp-km').value.trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    document.getElementById('email-error').style.display = 'block';
    return;
  }
  if (!km) { showToast('Ingresa los kilómetros actuales', 'error'); return; }
  // Save email immediately
  STATE.email = email;
  STATE.envioMensual = true;
  save();
  goStep(3);
}

function renderBig5() {
  const d = STATE.moto;
  if (!d) return;
  const km = parseInt(document.getElementById('inp-km').value) || 0;
  STATE.kmBase = km;
  STATE.kmDia = parseInt(document.getElementById('inp-kmdia').value) || 35;
  STATE.llantas = document.getElementById('sel-llantas').value;
  STATE.fechaBase = Date.now();
  save();

  const fields = [
    { key:'aceite', label:'Cambio de aceite', icon:'🛢️', hint:`Intervalo: ${d.intervalos.aceite.toLocaleString()} km` },
    { key:'arrastre', label:'Kit de arrastre (cadena/piñón)', icon:'🔗', hint:`Intervalo: ${d.intervalos.arrastre.toLocaleString()} km`, skip: !d.arrastre },
    { key:'frenos', label:'Pastillas de freno', icon:'🛑', hint:`Intervalo: ${d.intervalos.frenos.toLocaleString()} km` },
    { key:'filtroAire', label:'Filtro de aire', icon:'💨', hint:`Intervalo: ${d.intervalos.filtroAire.toLocaleString()} km` },
    { key:'llantas', label:'Cambio de llantas', icon:'⭕', hint:`Vida útil según compuesto` },
  ].filter(f => !f.skip);

  document.getElementById('big5-fields').innerHTML = fields.map(f => `
    <div class="ig">
      <div class="il">${f.icon} ${f.label} <span style="color:var(--metal);font-weight:400">— ${f.hint}</span></div>
      <input class="inp" type="number" placeholder="Km en que se hizo (ej: 15000)" id="b5-${f.key}" value="${STATE.bigFive[f.key] || ''}">
    </div>`).join('');
}

function handlePhoto(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    STATE.foto = ev.target.result;
    save();
    document.getElementById('photo-area').innerHTML = `
      <img src="${STATE.foto}" style="width:100%;height:100%;object-fit:cover;border-radius:12px">`;
  };
  reader.readAsDataURL(file);
}

function finishOnboarding() {
  // Save big5
  const keys = ['aceite','arrastre','frenos','filtroAire','llantas'];
  keys.forEach(k => {
    const el = document.getElementById(`b5-${k}`);
    if (el) STATE.bigFive[k] = parseInt(el.value) || 0;
  });
  save();
  document.getElementById('onboarding').style.display = 'none';
  showMainApp();
}

// ── MAIN APP ─────────────────────────────────────────────────
function showMainApp() {
  document.getElementById('splash').style.display = 'none';
  document.getElementById('onboarding').style.display = 'none';
  document.getElementById('main-app').style.display = 'block';
  document.getElementById('main-nav').classList.add('visible');
  renderDashboard();
