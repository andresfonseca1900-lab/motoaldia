}

function updateOdoDisplay() {
  const km = getKmActual();
  document.getElementById('dash-odo').innerHTML = `${km.toLocaleString('es-CO')}<span class="odometer-unit">km</span>`;
  document.getElementById('km-live').textContent = `${km.toLocaleString('es-CO')} km`;
}

// ── DASHBOARD ────────────────────────────────────────────────
function getSemaforoColor(pct) {
  if (pct > 0.4) return 'green';
  if (pct > 0.15) return 'amber';
  return 'red';
}

function getSemaforoClass(pct) {
  const c = getSemaforoColor(pct);
  return c === 'green' ? 'ok' : c === 'amber' ? 'warn' : 'crit';
}

function getCompPct(key) {
  const d = STATE.moto;
  if (!d) return 1;
  const km = getKmActual();
  const lastKm = STATE.bigFive[key] || 0;
  const interval = key === 'llantas'
    ? (STATE.llantas === 'calle' ? 20000 : STATE.llantas === 'dual' ? 14000 : 10000)
    : d.intervalos[key] || 10000;
  const used = km - lastKm;
  return Math.max(0, Math.min(1, 1 - (used / interval)));
}

function makeRing(pct, label, size = 54) {
  const r = size / 2 - 5;
  const circ = 2 * Math.PI * r;
  const offset = circ * (1 - pct);
  const color = pct > 0.4 ? 'var(--green)' : pct > 0.15 ? 'var(--amber)' : 'var(--red)';
  const kmLeft = STATE.moto ? Math.round(pct * (STATE.moto.intervalos[label] || 10000)) : 0;
  return `
    <div class="ring-wrap">
      <svg width="${size}" height="${size}" class="ring">
        <circle class="ring-bg" cx="${size/2}" cy="${size/2}" r="${r}" stroke-width="4"/>
        <circle class="ring-fill" cx="${size/2}" cy="${size/2}" r="${r}" stroke-width="4"
          stroke="${color}" stroke-dasharray="${circ}" stroke-dashoffset="${offset}"/>
        <text class="ring-text" x="${size/2}" y="${size/2}" transform="rotate(90 ${size/2} ${size/2})" style="font-size:9px;fill:var(--white)">${Math.round(pct*100)}%</text>
      </svg>
    </div>`;
}

function makeBarRow(name, pct, detail) {
  const color = pct > 0.4 ? 'var(--green)' : pct > 0.15 ? 'var(--amber)' : 'var(--red)';
  return `
    <div class="comp-row">
      <div class="comp-name">${name}<br><span class="comp-detail">${detail}</span></div>
      <div class="comp-bar-wrap">
        <div class="comp-bar-bg"><div class="comp-bar-fill" style="width:${Math.round(pct*100)}%;background:${color}"></div></div>
        <div style="font-size:10px;color:var(--metal);text-align:right;margin-top:2px">${Math.round(pct*100)}%</div>
      </div>
    </div>`;
}

function renderDashboard() {
  if (!STATE.moto) return;
  const d = STATE.moto;
  const km = getKmActual();

  document.getElementById('dash-moto-name').textContent = `${d.marca} ${d.modelo} ${d.año}`;
  updateOdoDisplay();
  if (STATE.foto) {
    const ph = document.getElementById('dash-moto-photo');
    ph.innerHTML = `<img src="${STATE.foto}" style="width:100%;height:100%;object-fit:cover">`;
  }

  // Alert aceite
  const pctAceite = getCompPct('aceite');
  const alertEl = document.getElementById('alert-aceite');
  if (pctAceite < 0.25) {
    const kmRestantes = Math.round(pctAceite * d.intervalos.aceite);
    const dias = Math.round(kmRestantes / STATE.kmDia);
    document.getElementById('alert-aceite-text').textContent =
      `Faltan ~${kmRestantes.toLocaleString()} km (${dias} días aprox). Aceite: ${d.aceiteRec}`;
    alertEl.style.display = 'block';
  } else { alertEl.style.display = 'none'; }

  // Subsystems
  const pctArrastre = d.arrastre ? getCompPct('arrastre') : null;
  const pctFrenos = getCompPct('frenos');
  const pctFiltroAire = getCompPct('filtroAire');
  const pctBujia = STATE.bigFive.bujia
    ? Math.max(0, 1 - (km - STATE.bigFive.bujia) / d.intervalos.bujia)
    : 0.8;
  const pctLlantas = getCompPct('llantas');
  const pctRefri = d.refrigeracionLiquida
    ? (STATE.bigFive.refrigerante ? Math.max(0, 1 - (km - STATE.bigFive.refrigerante) / d.intervalos.refrigerante) : 0.7)
    : null;

  const subsystems = [
    {
      icon:'⚙️', title:'Motor y Transmisión Interna',
      key:'motor',
      worst: Math.min(pctAceite, pctFiltroAire, pctBujia),
      html: `
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;padding:14px 0">
          ${makeRing(pctAceite, 'aceite')}
          ${makeRing(pctFiltroAire, 'filtroAire')}
          ${makeRing(pctBujia, 'bujia')}
          ${makeRing(Math.max(0, 1 - (km - (STATE.bigFive.valvulas||0)) / (d.intervalos.valvulas||15000)), 'valvulas')}
        </div>
        <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:4px;text-align:center;padding-bottom:10px">
          <div style="font-size:9px;color:var(--metal)">Aceite<br>${d.aceiteRec}</div>
          <div style="font-size:9px;color:var(--metal)">Filtro<br>Aire</div>
          <div style="font-size:9px;color:var(--metal)">Bujía<br>${d.intervalos.bujia/1000}k km</div>
          <div style="font-size:9px;color:var(--metal)">Válvulas<br>${d.intervalos.valvulas/1000}k km</div>
        </div>`
    },
    ...(d.arrastre ? [{
      icon:'🔗', title:'Transmisión Secundaria',
      key:'arrastre',
      worst: pctArrastre,
      html: `
        <div style="padding:10px 0">
          ${makeBarRow('Kit de Arrastre (Cadena · Piñón · Corona)', pctArrastre, `Cada ${d.intervalos.arrastre.toLocaleString()} km · ${Math.round(pctArrastre*d.intervalos.arrastre).toLocaleString()} km restantes`)}
          ${makeBarRow('Guayas (Embrague / Acelerador)', Math.max(0,1-(km-(STATE.bigFive.guayas||0))/(d.intervalos.guayas||25000)), `Cada ${d.intervalos.guayas.toLocaleString()} km`)}
        </div>`
    }] : []),
    {
      icon:'🛑', title:'Frenos y Seguridad Activa',
      key:'frenos',
      worst: pctFrenos,
      html: `
        <div style="padding:10px 0">
          ${makeBarRow('Pastillas Delanteras', pctFrenos, `Cada ${d.intervalos.frenos.toLocaleString()} km`)}
          ${makeBarRow('Pastillas Traseras', pctFrenos * 0.9, `Cada ${d.intervalos.frenos.toLocaleString()} km`)}
          ${makeBarRow('Líquido de Frenos', Math.max(0,1-(km-(STATE.bigFive.liquidoFrenos||0))/(d.intervalos.liquidoFrenos||20000)), `Cada ${d.intervalos.liquidoFrenos.toLocaleString()} km`)}
          ${makeBarRow('Cuñas / Rodamientos Dirección', Math.max(0,1-(km-(STATE.bigFive.cunasDireccion||0))/(d.intervalos.cunasDireccion||35000)), `Preventivo a ${d.intervalos.cunasDireccion.toLocaleString()} km`)}
        </div>`
    },
    {
      icon:'🌡️', title:`Refrigeración y Llantas${d.refrigeracionLiquida?'':' · Solo Llantas'}`,
      key:'llantas',
      worst: pctLlantas,
      html: `
        <div style="padding:10px 0">
          ${d.refrigeracionLiquida ? makeBarRow('Refrigerante (Radiador)', pctRefri, `Cada ${d.intervalos.refrigerante.toLocaleString()} km`) : ''}
          ${makeBarRow('Llanta Delantera', pctLlantas, `${STATE.llantas==='calle'?'20.000':STATE.llantas==='dual'?'14.000':'10.000'} km vida útil`)}
          ${makeBarRow('Llanta Trasera', pctLlantas*0.85, `Desgaste trasero ~15% mayor que delantera`)}
        </div>`
    },
  ];

  document.getElementById('subsystems-container').innerHTML = subsystems.map((s, i) => {
    const cls = getSemaforoClass(s.worst);
    const label = cls === 'ok' ? 'BIEN' : cls === 'warn' ? 'ATENCIÓN' : 'REVISAR';
    const hasDetail = ['motor','arrastre','frenos'].includes(s.key);
    const actionBtns = cls !== 'ok' ? `
      <div style="display:flex;gap:8px;padding:0 0 12px">
        ${hasDetail ? `<button onclick="abrirDetalleComponente('${s.key}')" style="flex:1;padding:9px;border-radius:8px;background:rgba(74,144,226,.1);border:1px solid rgba(74,144,226,.3);color:var(--blue);font-size:12px;font-weight:700;cursor:pointer;font-family:inherit">🔩 Ver desglose</button>` : ''}
        <button onclick="posponerAlViernes('${s.title}')" style="flex:1;padding:9px;border-radius:8px;background:transparent;border:1px solid var(--border);color:var(--metal);font-size:12px;cursor:pointer;font-family:inherit">📅 Recordar viernes</button>
      </div>` : '';
    return `
      <div class="subsys">
        <div class="subsys-header" onclick="toggleSubsys(${i})">
          <div class="subsys-title"><span>${s.icon}</span><span>${s.title}</span></div>
          <div style="display:flex;align-items:center;gap:8px">
            <span class="subsys-badge ${cls}">${label}</span>
            <span style="color:var(--metal);font-size:12px" id="subsys-arrow-${i}">▼</span>
          </div>
        </div>
        <div class="subsys-body ${i > 0 ? 'collapsed' : ''}" id="subsys-body-${i}">
          ${s.html}
          ${actionBtns}
        </div>
      </div>`;
  }).join('');
}

function toggleSubsys(i) {
  const body = document.getElementById(`subsys-body-${i}`);
  const arrow = document.getElementById(`subsys-arrow-${i}`);
  body.classList.toggle('collapsed');
  arrow.textContent = body.classList.contains('collapsed') ? '▼' : '▲';
}

function markDone(component) {
  const km = getKmActual();
  STATE.bigFive[component] = km;
  STATE.historial.unshift({ fecha: new Date().toLocaleDateString('es-CO'), titulo: `Cambio de ${component}`, km, costo: 0 });
  save();
  renderDashboard();
  renderHV();
}

// ── WEATHER ──────────────────────────────────────────────────
async function loadWeather() {
  try {
    const r = await fetch('https://wttr.in/Bogota?format=j1');
    const d = await r.json();
    const rain = d.current_condition?.[0]?.weatherDesc?.[0]?.value?.toLowerCase() || '';
    if (rain.includes('rain') || rain.includes('lluvi') || rain.includes('drizzle') || rain.includes('shower')) {
      document.getElementById('weather-banner').style.display = 'flex';
    }
  } catch(e) { /* silent fail */ }
}

// ── HOJA DE VIDA ─────────────────────────────────────────────
function renderHV() {
  if (!STATE.moto) return;
  const d = STATE.moto;
  const km = getKmActual();
  document.getElementById('hv-title').textContent = `${d.marca} ${d.modelo}`;
  document.getElementById('hv-sub').textContent = `${d.año} · ${km.toLocaleString('es-CO')} km acumulados`;

  document.getElementById('hv-ficha').innerHTML = [
    ['Aceite oficial', d.aceiteRec],
    ['Intervalo aceite', `${d.intervalos.aceite.toLocaleString()} km`],
    ['Refrigeración', d.refrigeracionLiquida ? 'Líquida' : 'Aire'],
    ['Tipo', d.tipo],
    ['Cilindrada', `${d.cilindrada} cc`],
    ['Kit de arrastre', d.arrastre ? `Cada ${d.intervalos.arrastre.toLocaleString()} km` : 'No aplica (scooter)'],
  ].map(([k,v]) => `
    <div class="hvr">
      <span style="font-size:12px;color:var(--metal)">${k}</span>
      <span style="font-size:12px;color:var(--white);font-weight:600">${v}</span>
    </div>`).join('');

