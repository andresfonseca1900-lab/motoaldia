// ── 4. RECORDAR AL VIERNES ───────────────────────────────────
function posponerAlViernes(componente) {
  const correo = STATE.email;
  if (!STATE.pendientesViernes) STATE.pendientesViernes = [];
  // Find next Friday
  const hoy = new Date();
  const diasHastaViernes = (5 - hoy.getDay() + 7) % 7 || 7;
  const viernes = new Date(hoy.getTime() + diasHastaViernes * 86400000);
  const fechaStr = viernes.toLocaleDateString('es-CO', { weekday:'long', day:'numeric', month:'long' });
  STATE.pendientesViernes.push({ componente, fechaProgramada: fechaStr });
  save();
  const msg = correo
    ? `Recordatorio programado para el ${fechaStr}. Se enviará aviso a ${correo}.`
    : `Recordatorio programado para el ${fechaStr}. Vincula tu correo en Ajustes para recibirlo por email.`;
  showToast(`📅 ${msg}`, 'ok');
}

// ── 5. EXPORTAR / IMPORTAR RESPALDO JSON ─────────────────────
function exportarRespaldoJSON() {
  const dataStr = "data:text/json;charset=utf-8," + encodeURIComponent(JSON.stringify(STATE, null, 2));
  const a = document.createElement('a');
  a.setAttribute("href", dataStr);
  a.setAttribute("download", `respaldo_tu_moto_${(STATE.moto?.modelo||'data').replace(/\s/g,'_')}_${new Date().toISOString().slice(0,10)}.json`);
  document.body.appendChild(a);
  a.click();
  a.remove();
  document.getElementById('respaldo-result').innerHTML = '<div style="color:var(--green);font-size:13px;font-weight:600;padding:8px 0">✅ Respaldo exportado correctamente.</div>';
}

function importarRespaldoJSON(event) {
  const reader = new FileReader();
  if (!event.target.files[0]) return;
  reader.readAsText(event.target.files[0], "UTF-8");
  reader.onload = (e) => {
    try {
      const parsed = JSON.parse(e.target.result);
      if (parsed && parsed.moto) {
        STATE = parsed;
        save();
        document.getElementById('respaldo-result').innerHTML = '<div style="color:var(--green);font-size:13px;font-weight:600;padding:8px 0">✅ Respaldo importado. Recargando...</div>';
        setTimeout(() => location.reload(), 1200);
      } else {
        document.getElementById('respaldo-result').innerHTML = '<div style="color:var(--red);font-size:13px;padding:8px 0">⚠️ El archivo no tiene el formato correcto.</div>';
      }
    } catch {
      document.getElementById('respaldo-result').innerHTML = '<div style="color:var(--red);font-size:13px;padding:8px 0">⚠️ Error al leer el archivo JSON.</div>';
    }
  };
}

// ── 6. ENVÍO MENSUAL AUTOMÁTICO ──────────────────────────────
function verificarEnvioMensualHojaDeVida() {
  const ultimo = localStorage.getItem('tmad_ultimo_envio_mensual');
  const ahora = Date.now();
  if (!ultimo || (ahora - parseInt(ultimo)) > 2592000000) {
    if (STATE.email && STATE.envioMensual !== false) {
      console.log(`[TMAD] Hoja de vida enviada automáticamente a ${STATE.email}`);
      localStorage.setItem('tmad_ultimo_envio_mensual', ahora.toString());
      showToast(`📧 Hoja de vida enviada a ${STATE.email}`, 'ok');
    }
  }
}

// ── 7. ACCESORIOS LIBRES ─────────────────────────────────────
const ACCESORIOS_SUGERIDOS = ['Alarma Scorpio', 'GPS Coban', 'Intercom Cardo', 'Maletero', 'Exploradoras LED', 'Manilares deportivos', 'Escape Akrapovič', 'Cámara de acción', 'GPS Teltonika', 'Seguro en disco'];

function openModal(id) {
  // Re-render chips when opening accesorio modal
  if (id === 'modal-accesorio') {
    const saved = STATE.accesoriosLibres || [];
    document.getElementById('chips-accesorios').innerHTML = ACCESORIOS_SUGERIDOS.map(a =>
      `<span class="chip-accesorio${saved.find(s=>s.nombre===a)?' selected':''}" onclick="toggleChipAccesorio(this,'${a}')">${a}</span>`
    ).join('');
    renderAccesoriosLibres();
  }
  document.getElementById(id).classList.add('open');
}

function toggleChipAccesorio(el, nombre) {
  el.classList.toggle('selected');
  if (el.classList.contains('selected')) {
    guardarAccesorioLibreNombre(nombre);
  } else {
    eliminarAccesorioLibre(nombre);
  }
}

function guardarAccesorioLibre() {
  const nombre = document.getElementById('inp-accesorio-libre').value.trim();
  if (!nombre) return;
  guardarAccesorioLibreNombre(nombre);
  document.getElementById('inp-accesorio-libre').value = '';
}

function guardarAccesorioLibreNombre(nombre) {
  if (!STATE.accesoriosLibres) STATE.accesoriosLibres = [];
  if (STATE.accesoriosLibres.find(a => a.nombre === nombre)) return;
  STATE.accesoriosLibres.push({ nombre, fechaAgregado: new Date().toLocaleDateString('es-CO') });
  save();
  renderAccesoriosLibres();
  renderPerfil();
}

function eliminarAccesorioLibre(nombre) {
  if (!STATE.accesoriosLibres) return;
  STATE.accesoriosLibres = STATE.accesoriosLibres.filter(a => a.nombre !== nombre);
  save();
  renderAccesoriosLibres();
}

function renderAccesoriosLibres() {
  const panel = document.getElementById('accesorios-guardados');
  if (!panel) return;
  const lista = STATE.accesoriosLibres || [];
  panel.innerHTML = lista.length ? `
    <div style="margin-top:10px">
      <div style="font-size:11px;color:var(--metal);margin-bottom:6px">ACCESORIOS AÑADIDOS</div>
      ${lista.map(a => `
        <div style="display:flex;justify-content:space-between;align-items:center;padding:7px 0;border-bottom:1px solid var(--border)">
          <div style="font-size:13px;color:var(--white)">${a.nombre} <span style="font-size:11px;color:var(--metal)">· ${a.fechaAgregado}</span></div>
          <button onclick="eliminarAccesorioLibre('${a.nombre}')" style="background:none;border:none;color:var(--red);font-size:16px;cursor:pointer">×</button>
        </div>`).join('')}
    </div>` : '';
}

// ── TOAST NOTIFICATIONS ──────────────────────────────────────
function showToast(msg, type='ok') {
  const existing = document.getElementById('tmad-toast');
  if (existing) existing.remove();
  const toast = document.createElement('div');
  toast.id = 'tmad-toast';
  toast.style.cssText = `
    position:fixed;bottom:100px;left:50%;transform:translateX(-50%);
    background:${type==='ok'?'#1a3a1a':'#3a1a1a'};
    border:1px solid ${type==='ok'?'var(--green)':'var(--red)'};
    color:${type==='ok'?'var(--green)':'#FF6B6B'};
    padding:10px 18px;border-radius:20px;font-size:13px;font-weight:600;
    z-index:300;white-space:nowrap;max-width:340px;text-align:center;
    animation:fadeIn .2s ease;`;
  toast.textContent = msg;
  document.body.appendChild(toast);
  setTimeout(() => toast.remove(), 3200);
}
