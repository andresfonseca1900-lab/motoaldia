async function callAnalizarFactura(texto, base64) {
  const d = STATE.moto;
  if (!d) { alert('Configura tu moto primero'); return; }
  const result = document.getElementById('factura-result');
  result.innerHTML = '<div class="spinner"></div>';

  const prompt = `Eres el asistente de "Tu Moto al Día". El usuario tiene una ${d.marca} ${d.modelo}.
Datos técnicos: aceite ${d.aceiteRec}, filtros de aceite: 1, filtros de aire: 1, refrigerante: ${d.refrigeracionLiquida?'SÍ':'NO'}.

${texto ? `Factura:\n${texto}` : 'Analiza la imagen de la factura adjunta.'}

Responde SOLO en JSON sin backticks:
{"items":[{"nombre":"...","valor":0,"ok":true,"razon":""}],"total":0,"alertas":[],"resumen":"...","puntaje":85}

ok=false si: cantidad incorrecta para el modelo, servicio que no aplica, precio anómalo en Colombia.`;

  const messages = base64
    ? [{ role:'user', content:[
        { type:'image', source:{ type:'base64', media_type:'image/jpeg', data:base64 } },
        { type:'text', text:prompt }
      ]}]
    : [{ role:'user', content:prompt }];

  try {
    const res = await fetch('https://api.anthropic.com/v1/messages', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ model:'claude-sonnet-4-6', max_tokens:1000, messages })
    });
    const data = await res.json();
    const text = (data.content?.[0]?.text||'{}').replace(/```json|```/g,'').trim();
    const parsed = JSON.parse(text);
    const scoreColor = parsed.puntaje >= 80 ? 'var(--green)' : parsed.puntaje >= 60 ? 'var(--amber)' : 'var(--red)';
    result.innerHTML = `
      <div>
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
          <div style="width:52px;height:52px;border-radius:50%;border:3px solid ${scoreColor};display:flex;align-items:center;justify-content:center;flex-direction:column;flex-shrink:0">
            <div style="font-size:16px;font-weight:900;color:${scoreColor}">${parsed.puntaje}</div>
            <div style="font-size:8px;color:var(--metal)">/100</div>
          </div>
          <div><div style="font-size:14px;font-weight:700;color:var(--white)">Análisis completo</div><div style="font-size:12px;color:var(--metal);margin-top:2px">${parsed.resumen}</div></div>
        </div>
        ${parsed.alertas?.length ? `<div style="background:rgba(224,43,43,.1);border:1px solid var(--red-dim);border-radius:10px;padding:10px 12px;margin-bottom:10px">${parsed.alertas.map(a=>`<div style="font-size:12px;color:#FF6B6B;margin-bottom:4px">⚠️ ${a}</div>`).join('')}</div>` : ''}
        ${(parsed.items||[]).map(item => `
          <div class="${item.ok?'ai-ok':'ai-err'}">
            <span style="font-size:14px;flex-shrink:0">${item.ok?'✅':'⚠️'}</span>
            <div><div style="font-size:13px;color:var(--white);font-weight:500">${item.nombre}</div>
            ${item.valor>0?`<div style="font-size:11px;color:var(--metal)">$${item.valor.toLocaleString('es-CO')}</div>`:''}
            ${!item.ok&&item.razon?`<div style="font-size:12px;color:#FF6B6B;margin-top:3px">${item.razon}</div>`:''}</div>
          </div>`).join('')}
        ${parsed.total>0?`<div style="font-size:14px;font-weight:700;color:var(--white);text-align:right;padding:10px 0;border-top:1px solid var(--border)">Total: $${parsed.total.toLocaleString('es-CO')}</div>`:''}
      </div>`;
  } catch(e) {
    result.innerHTML = '<div style="color:var(--red);font-size:13px;padding:10px 0">Error al analizar. Verifica tu conexión.</div>';
  }
}

